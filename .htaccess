# Block access to sensitive files
<FilesMatch "\.(sql|md|log|bak|ini|env)$">
    Require all denied
</FilesMatch>

# Block access to git repository (source code + history)
RedirectMatch 404 (^|/)\.git(/|$)
<FilesMatch "^\.git">
    Require all denied
</FilesMatch>

# Disable directory listing
Options -Indexes
